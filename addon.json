{
  "$schema": "../ttrpg-codex/contracts/addons/v3/manifest.schema.json",
  "packageFormat": 1,
  "id": "dnd-sheets",
  "name": "D&D Character Sheets",
  "version": "4.0.0",
  "description": "Reversible character builds, tracked DM grants and explained rules.",
  "license": "MIT",
  "compatibility": {
    "host": ">=2.0.0 <3.0.0",
    "addonApi": "^3.0.0",
    "workerProtocol": "^1.0.0"
  },
  "capabilities": {
    "required": [
      "ui.contributions",
      "worker.native",
      "ui.rule-details"
    ],
    "optional": []
  },
  "runtime": {
    "ui": {
      "mode": "integrated",
      "entry": "web/index.js",
      "styles": [
        "web/index.css"
      ]
    },
    "worker": {
      "type": "native",
      "protocol": "^1.0.0",
      "entrypoints": {
        "windows-amd64": "worker/windows-amd64/dnd-sheets.exe",
        "linux-amd64": "worker/linux-amd64/dnd-sheets",
        "linux-arm64": "worker/linux-arm64/dnd-sheets"
      }
    }
  },
  "permissions": [],
  "contributions": [
    {
      "id": "sheet.section",
      "surface": "article-section",
      "label": "D&D Character Sheet",
      "roles": [
        "dm",
        "player"
      ],
      "order": 100,
      "requires": [
        "ui.contributions"
      ],
      "config": {
        "collection": "characters",
        "labels": {
          "cs": "Deník postavy D&D"
        }
      }
    }
  ],
  "recordExtensions": [
    {
      "id": "dnd-sheets",
      "target": "characters",
      "visibility": "public",
      "schema": "contracts/sheet-state.schema.json",
      "schemaVersion": "4.0.0",
      "workerOnly": true
    }
  ],
  "services": {
    "consumes": [
      {
        "contract": "dnd5e.rules-engine",
        "range": "^4.0.0",
        "cardinality": "one",
        "required": false,
        "selection": "operator"
      },
      {
        "contract": "dnd5e.character",
        "range": "^2.0.0",
        "cardinality": "many",
        "required": false,
        "selection": "all-compatible"
      }
    ],
    "provides": [
      {
        "contract": "dnd5e.character",
        "version": "2.0.0",
        "transport": "worker",
        "schema": "contracts/character.service.json"
      }
    ]
  }
}
